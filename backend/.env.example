# ──────────────────────────────────────────────────────────────
# SK실트론 MDD 환경 설정 파일
#
# 이 파일을 backend/.env 로 복사 후 값을 수정하세요.
#   Windows : copy backend\.env.example backend\.env
#   Linux   : cp backend/.env.example backend/.env
#
# backend/.env 는 비밀번호가 포함되므로 외부 공유 금지
# ──────────────────────────────────────────────────────────────

# PostgreSQL 연결 URL (필수)
# 형식: postgresql+asyncpg://유저:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgresql+asyncpg://postgres:비밀번호@localhost:5432/mdd_db

# 서버 포트 (선택, 기본값 5000)
# start.py --port 옵션으로도 변경 가능
# PORT=5000

# 서버 바인딩 주소 (선택, 기본값 0.0.0.0 = 모든 네트워크 인터페이스)
# 특정 IP만 허용하려면 해당 IP 입력
# HOST=0.0.0.0
